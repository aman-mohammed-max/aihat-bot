APP_ENV=development
LOG_LEVEL=debug
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/aihat.sqlite
OBJECTS_PATH=./data/objects
MODEL_ALLOWED_ORIGINS=https://api.openai.com
MODEL_RETRY_MAX_ATTEMPTS=2
MODEL_RETRY_BACKOFF_MS=250
MODEL_IMAGE_INPUT=false
# Only list exact HTTPS origins whose OpenAI-compatible SSE behavior is verified.
MODEL_STREAMING_ORIGINS=https://api.openai.com
# Add exact HTTPS origins only after strict JSON-schema response behavior is verified.
MODEL_STRUCTURED_OUTPUT_ORIGINS=
HTTP_SKILL_ALLOWED_ORIGINS=
MCP_ALLOWED_ORIGINS=
# Optional HTTPS malware-scanning gateway. The origin must exactly match the allowlist.
FILE_SCANNER_ENDPOINT=
FILE_SCANNER_ALLOWED_ORIGINS=
FILE_SCANNER_TOKEN=
# Central OpenAI-compatible model used to draft a bot's creative setup fields.
FACTORY_LLM_ENDPOINT=
FACTORY_LLM_MODEL=
FACTORY_LLM_TOKEN=
# Public HTTPS base URL; runtimes add Telegram webhook paths below it.
TELEGRAM_WEBHOOK_BASE_URL=

# BotFather master bot token used to verify Telegram Mini App initData.
# Store the secret outside source control. TELEGRAME_BOT_TOKEN is accepted as a legacy alias.
TELEGRAM_MASTER_BOT_TOKEN=
# Distinct random secret for validating the master bot webhook. Generate with: openssl rand -hex 32
TELEGRAM_MASTER_WEBHOOK_SECRET=

# Generate a fresh 32-byte key with: openssl rand -base64 32
# Keep this value in a deployment secret store. Never commit a real key.
SECRET_ACTIVE_KEY_ID=local-key-1
SECRET_KEYRING_JSON={"local-key-1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}

# Optional high-entropy platform-operator secret for global skill catalog administration.
SKILL_CATALOG_ADMIN_TOKEN=
