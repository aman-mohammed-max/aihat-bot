{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aihat-bot-factory",
  "main": "src/index.ts",
  "assets": {
    "directory": "../../apps/dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-30",
  "alias": { "@aihat/core": "../../packages/core/src/index.ts" },
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ENV": "development",
    "MODEL_ALLOWED_ORIGINS": "https://api.openai.com",
    "MODEL_RETRY_MAX_ATTEMPTS": "2",
    "MODEL_RETRY_BACKOFF_MS": "250",
    "TELEGRAM_RETRY_MAX_ATTEMPTS": "2",
    "TELEGRAM_RETRY_MAX_AFTER_SECONDS": "3",
    "TELEGRAM_MASTER_REQUESTS_PER_MINUTE": "30",
    "TELEGRAM_CUSTOMER_REQUESTS_PER_MINUTE": "30",
    "SCHEDULED_TASK_RETRY_MAX_ATTEMPTS": "5",
    "SCHEDULED_TASK_RETRY_BACKOFF_MS": "30000",
    "SCHEDULED_TASK_RETRY_MAX_BACKOFF_MS": "3600000",
    "MODEL_STREAMING_ORIGINS": "https://api.openai.com",
    "MODEL_STRUCTURED_OUTPUT_ORIGINS": "",
    "HTTP_SKILL_ALLOWED_ORIGINS": "",
    "MCP_ALLOWED_ORIGINS": "",
    "FILE_SCANNER_ENDPOINT": "",
    "FILE_SCANNER_ALLOWED_ORIGINS": "",
    "FACTORY_LLM_ENDPOINT": "https://freellmapi-production-5248.up.railway.app/v1",
    "FACTORY_LLM_MODEL": "auto",
    "TELEGRAM_WEBHOOK_BASE_URL": "https://aihat-bot-factory.work-fdc.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOT_COORDINATOR", "class_name": "BotCoordinator" },
      { "name": "CONVERSATION_COORDINATOR", "class_name": "ConversationCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BotCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["ConversationCoordinator"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aihat-bot-development",
      "database_id": "41b78acb-ad21-47f0-8b54-2e3642427c1a",
      "migrations_dir": "../../migrations/sqlite"
    }
  ],
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "aihat-bot-development" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "aihat-bot-development" }],
    "consumers": [{ "queue": "aihat-bot-development", "max_batch_size": 1, "max_retries": 5 }]
  },
  "env": {
    "staging": {
      "name": "aihat-bot-factory-staging",
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "APP_ENV": "staging",
        "MODEL_ALLOWED_ORIGINS": "https://api.openai.com",
        "MODEL_RETRY_MAX_ATTEMPTS": "2",
        "MODEL_RETRY_BACKOFF_MS": "250",
        "TELEGRAM_RETRY_MAX_ATTEMPTS": "2",
        "TELEGRAM_RETRY_MAX_AFTER_SECONDS": "3",
        "TELEGRAM_MASTER_REQUESTS_PER_MINUTE": "30",
        "TELEGRAM_CUSTOMER_REQUESTS_PER_MINUTE": "30",
        "SCHEDULED_TASK_RETRY_MAX_ATTEMPTS": "5",
        "SCHEDULED_TASK_RETRY_BACKOFF_MS": "30000",
        "SCHEDULED_TASK_RETRY_MAX_BACKOFF_MS": "3600000",
        "MODEL_STREAMING_ORIGINS": "https://api.openai.com",
        "MODEL_STRUCTURED_OUTPUT_ORIGINS": "",
        "HTTP_SKILL_ALLOWED_ORIGINS": "",
        "MCP_ALLOWED_ORIGINS": "",
        "FILE_SCANNER_ENDPOINT": "",
        "FILE_SCANNER_ALLOWED_ORIGINS": "",
        "FACTORY_LLM_ENDPOINT": "",
        "FACTORY_LLM_MODEL": "",
        "TELEGRAM_WEBHOOK_BASE_URL": ""
      },
      "durable_objects": {
        "bindings": [
          { "name": "BOT_COORDINATOR", "class_name": "BotCoordinator" },
          { "name": "CONVERSATION_COORDINATOR", "class_name": "ConversationCoordinator" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aihat-bot-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../migrations/sqlite"
        }
      ],
      "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "aihat-bot-staging" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "aihat-bot-staging" }],
        "consumers": [{ "queue": "aihat-bot-staging", "max_batch_size": 1, "max_retries": 5 }]
      }
    },
    "production": {
      "name": "aihat-bot-factory-production",
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "APP_ENV": "production",
        "MODEL_ALLOWED_ORIGINS": "https://api.openai.com",
        "MODEL_RETRY_MAX_ATTEMPTS": "2",
        "MODEL_RETRY_BACKOFF_MS": "250",
        "TELEGRAM_RETRY_MAX_ATTEMPTS": "2",
        "TELEGRAM_RETRY_MAX_AFTER_SECONDS": "3",
        "TELEGRAM_MASTER_REQUESTS_PER_MINUTE": "30",
        "TELEGRAM_CUSTOMER_REQUESTS_PER_MINUTE": "30",
        "SCHEDULED_TASK_RETRY_MAX_ATTEMPTS": "5",
        "SCHEDULED_TASK_RETRY_BACKOFF_MS": "30000",
        "SCHEDULED_TASK_RETRY_MAX_BACKOFF_MS": "3600000",
        "MODEL_STREAMING_ORIGINS": "https://api.openai.com",
        "MODEL_STRUCTURED_OUTPUT_ORIGINS": "",
        "HTTP_SKILL_ALLOWED_ORIGINS": "",
        "MCP_ALLOWED_ORIGINS": "",
        "FILE_SCANNER_ENDPOINT": "",
        "FILE_SCANNER_ALLOWED_ORIGINS": "",
        "FACTORY_LLM_ENDPOINT": "",
        "FACTORY_LLM_MODEL": "",
        "TELEGRAM_WEBHOOK_BASE_URL": ""
      },
      "durable_objects": {
        "bindings": [
          { "name": "BOT_COORDINATOR", "class_name": "BotCoordinator" },
          { "name": "CONVERSATION_COORDINATOR", "class_name": "ConversationCoordinator" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aihat-bot-production",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "../../migrations/sqlite"
        }
      ],
      "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "aihat-bot-production" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "aihat-bot-production" }],
        "consumers": [{ "queue": "aihat-bot-production", "max_batch_size": 1, "max_retries": 5 }]
      }
    }
  }
}
