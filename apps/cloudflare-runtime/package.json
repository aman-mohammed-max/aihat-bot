{
  "name": "@aihat/cloudflare-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../.. build:dashboard && wrangler dev",
    "dev:staging": "bun run --cwd ../.. build:dashboard && wrangler dev --env staging",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.json --noEmit",
    "build": "bun run --cwd ../.. build:dashboard && wrangler deploy --dry-run --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@aihat/core": "workspace:*"
  }
}
